%% version 2005/12/01 or later.
%%

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{spotxcolor-xespotcolor}
  [2026/10/09 v1.8 Compatibility replacement for xespotcolor, via spotxcolor]

\PackageInfo{spotxcolor-xespotcolor}
  {This is spotxcolor's compatibility replacement for the legacy\MessageBreak
   `xespotcolor' package. See spotxcolor.pdf for the full modern interface}

\RequirePackage{iftex}
\RequirePackage{spotxcolor}
\RequirePackage{spotxcolor-legacycolor}

\newif\ifspotxcolor@legacy@hks
\newif\ifspotxcolor@legacy@pantone
\DeclareOption{hks}{\spotxcolor@legacy@hkstrue}
\DeclareOption{pantone}{\spotxcolor@legacy@pantonetrue}
% `xcolor' is always in effect under spotxcolor; kept only so that
% \usepackage[xcolor]{xespotcolor} does not raise an "unused option" error.
\DeclareOption{xcolor}{}
\ProcessOptions\relax

% Preload the requested tables lazily -- see spotxcolor-legacycolor.sty.
\ifspotxcolor@legacy@hks
  \spotxcolorlegacypreload{spotxcolor-hks.def}
\fi
\ifspotxcolor@legacy@pantone
  \spotxcolorlegacypreload{spotxcolor-pantone.def}
\fi

% =====================================================================
% --- Legacy PGF driver macros for the `spotcolor' model ---
% =====================================================================
% The original xespotcolor defined these so that PGF/TikZ could render a
% color declared with model `spotcolor' directly (bypassing xcolor). They
% are largely superseded by spotxcolor's own auto-detecting PGF driver
% patches (core spotxcolor.sty), which fire for ordinary xcolor usage; these
% are kept only for documents that reference the low-level PGF color model
% `spotcolor' explicitly. Each ensures the color is registered before
% emitting the raw PDF operator, exactly as \SpotColor does.
\makeatletter
\newcommand\pgfsys@color@spotcolor@stroke[2]{%
  \spotxcolorlegacyensure{#1}%
  \pgfsysprotocol@literal{/#1 CS #2 SC}%
}
\newcommand\pgfsys@color@spotcolor@fill[2]{%
  \spotxcolorlegacyensure{#1}%
  \pgfsysprotocol@literal{/#1 cs #2 sc}%
}
\newcommand\pgfsys@color@spotcolor[2]{%
  \pgfsys@color@spotcolor@stroke{#1}{#2}%
  \pgfsys@color@spotcolor@fill{#1}{#2}%
}
\makeatother

\endinput
